# Backend Environment Variables Example
# Copy this file to .env and fill in the required values

# ===== Authentication Configuration =====
# Auth0 Domain for JWT verification
AUTH0_DOMAIN=your-tenant.us.auth0.com
# Auth0 API Audience (the unique identifier for your API)
AUTH0_AUDIENCE=https://your-api-identifier.com

# ===== Anthropic API Configuration =====
# Your Anthropic API key (required for chat functionality)
# Get this from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Anthropic model to use (default is claude-3-5-sonnet-20240620)
# Available models: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-5-sonnet-20240620
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# ===== Optional OpenAI Configuration =====
# Used for the text transformer feature
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ===== Server Configuration =====
# Server host (default: 0.0.0.0)
SERVER_HOST=0.0.0.0
# Server port (default: 8000)
SERVER_PORT=8000
# Set to 'production' for deployment
ENVIRONMENT=development 