{
  "name": "clarity-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "copy-pdf-worker": "node -e \"const fs=require('fs'); const path=require('path'); const src=path.join(__dirname,'node_modules','pdfjs-dist','build','pdf.worker.min.js'); const dest=path.join(__dirname,'public','pdf.worker.min.js'); !fs.existsSync(path.join(__dirname,'public')) && fs.mkdirSync(path.join(__dirname,'public')); fs.copyFileSync(src,dest);\"",
    "build": "npm run copy-pdf-worker && tsc && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.0.0",
    "@auth0/auth0-spa-js": "^2.0.0",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-icons": "^1.3.0",
    "@sentry/react": "^7.120.3",
    "@sentry/tracing": "^7.0.0",
    "@shadcn/ui": "^0.0.4",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/styled-components": "^5.1.34",
    "axios": "^1.8.2",
    "clsx": "^2.1.1",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.9.0",
    "officegen": "^0.6.5",
    "pdfjs-dist": "^3.11.174",
    "pizzip": "^3.1.8",
    "pptx-parser": "^1.1.7-beta.9",
    "pptxgenjs": "^3.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-pdf": "^7.5.1",
    "react-router-dom": "^6.20.0",
    "styled-components": "^6.1.8",
    "tailwind-merge": "^3.0.2",
    "tesseract.js": "^6.0.0"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.32",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  }
}
